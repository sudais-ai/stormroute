# StormRoute — environment variable names (placeholders only; never commit real values)
# Copy to backend/.env (gitignored) and fill with real values before Phase 3 integration.

# Mapbox access token — required for Directions (route alternatives) + Geocoding.
# Free tier; create at cloud.mapbox.com without storing the value anywhere public.
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Django secret key override for non-dev deployments.
DJANGO_SECRET_KEY=change-me-in-production

# Phase 4: hard cap on sampled checkpoints per route (default 500).
# Sampling widens spacing instead of truncating; the destination stays included.
CHECKPOINT_MAX_PER_ROUTE=500

# Not required: Open-Meteo weather API needs no key for non-commercial use.
# Not required: OpenFreeMap map tiles need no key.
